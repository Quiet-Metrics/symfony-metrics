{
    "name": "laboiteacode/webanalytics-symfony",
    "description": "Bundle Symfony du SDK Affluence (La Boîte à Code) : pageviews serveur automatiques via kernel.terminate et configuration sémantique.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "analytics",
        "symfony",
        "privacy",
        "rgpd",
        "sans-cookies",
        "server-side"
    ],
    "require": {
        "php": ">=8.1",
        "laboiteacode/webanalytics-php": "^1.0@dev",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "LaBoiteACode\\WebAnalytics\\Symfony\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "symfony/framework-bundle": "^6.4 || ^7.0"
    },
    "autoload-dev": {
        "psr-4": {
            "LaBoiteACode\\WebAnalytics\\Symfony\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
