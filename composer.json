{
    "name": "laboiteacode/webanalytics-symfony",
    "description": "Bundle Symfony du SDK WebAnalytics — pageviews serveur automatiques (kernel.terminate) et configuration.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["analytics", "symfony", "privacy", "rgpd", "sans-cookies", "server-side"],
    "require": {
        "php": ">=8.1",
        "laboiteacode/webanalytics-php": "^0.1",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "LaBoiteACode\\WebAnalytics\\Symfony\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
